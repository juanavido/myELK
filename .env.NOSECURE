# =====================================================
# ELK Stack SIN Seguridad (HTTP, sin TLS) - PLANTILLA
# =====================================================
# Instalación desde cero:
#   cp .env.NOSECURE .env
#   ./start.sh
# =====================================================

# Versión del stack Elastic
ES_LOCAL_VERSION=8.17.0

# =====================================================
# ELASTICSEARCH
# =====================================================
ES_LOCAL_CLUSTER_NAME=elk-local-cluster
ES_LOCAL_CONTAINER_NAME_NODE01=es-local-node-01
ES_LOCAL_CONTAINER_NAME_NODE02=es-local-node-02
ES_LOCAL_CONTAINER_NAME_NODE03=es-local-node-03
ES_LOCAL_PORT_NODE01=9201
ES_LOCAL_PORT_NODE02=9202
ES_LOCAL_PORT_NODE03=9203
ES_LOCAL_URL=http://localhost:9201
ES_LOCAL_JAVA_OPTS="-Xms512m -Xmx512m"
ES_LOCAL_DISK_SPACE_REQUIRED=1gb

# =====================================================
# CREDENCIALES (sin seguridad activa; se mantiene por compatibilidad)
# =====================================================
ELASTIC_PASSWORD=tXrCLc79

# =====================================================
# LOGSTASH
# =====================================================
LOGSTASH_LOCAL_CONTAINER_NAME=logstash-local
LOGSTASH_BEATS_PORT=5044
LOGSTASH_TCP_PORT=5000
LOGSTASH_HTTP_PORT=9600
LOGSTASH_JAVA_OPTS="-Xms256m -Xmx256m"

# =====================================================
# KIBANA
# =====================================================
KIBANA_LOCAL_CONTAINER_NAME=kibana-local
KIBANA_LOCAL_PORT=5601
